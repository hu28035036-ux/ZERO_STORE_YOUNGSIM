# Supabase 프로젝트 설정 > API 에서 확인
# 레거시 anon JWT 가 아니라 신형 publishable 키(sb_publishable_...)를 사용한다.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# secret 키는 이 앱에 두지 않는다.
# 모든 쓰기는 로그인 사용자 권한으로 RLS 를 통과해야 created_by 감사 기록이 성립한다.
