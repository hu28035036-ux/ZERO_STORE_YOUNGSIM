# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# 키가 없는 템플릿은 커밋한다. 새로 받는 사람이 무엇을 채워야 하는지 알아야 한다.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# PWA 서비스워커 빌드 산출물 (Serwist 가 생성)
/public/sw.js
/public/sw.js.map
/public/swe-worker-*.js

# postinstall 로 복사되는 ZXing WASM 바이너리
/public/wasm/

# subagent-driven-development 작업 기록 (스크래치)
.superpowers
