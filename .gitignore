# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# 키가 없는 템플릿은 커밋한다. 새로 받는 사람이 무엇을 채워야 하는지 알아야 한다.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# PWA 서비스워커 빌드 산출물 (Serwist 가 생성)
/public/sw.js
/public/sw.js.map
/public/swe-worker-*.js

# 빌드 때 node_modules 에서 복사해온다 (scripts/copy-zxing-wasm.mjs).
# postinstall 이 아니라 build/dev 스크립트에서 매번 복사한다 — postinstall 은 설치
# 방식에 따라 건너뛸 수 있고, 그러면 이 파일이 없어도 빌드가 조용히 통과해서
# 아이폰에서만, 배포되고 나서야 스캔이 깨진다.
/public/zxing_reader.wasm

# subagent-driven-development 작업 기록 (스크래치)
.superpowers
